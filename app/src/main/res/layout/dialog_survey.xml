<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dialog_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/survey_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/survey_title"
            android:textSize="@dimen/text_size_heading"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_small"/>

        <TextView
            android:id="@+id/survey_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/survey_subtitle"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_large"/>

        <!-- Q1: Overall Condition -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/survey_q1"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/margin_small"/>

        <RadioGroup
            android:id="@+id/q1_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium">
            <RadioButton android:id="@+id/q1_excellent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q1_excellent"/>
            <RadioButton android:id="@+id/q1_very_good" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q1_very_good"/>
            <RadioButton android:id="@+id/q1_good" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q1_good"/>
            <RadioButton android:id="@+id/q1_fair" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q1_fair"/>
            <RadioButton android:id="@+id/q1_poor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q1_poor"/>
        </RadioGroup>

        <!-- Q2: Replaced Components -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/survey_q2"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/margin_small"/>

        <CheckBox android:id="@+id/q2_none" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q2_none"/>
        <CheckBox android:id="@+id/q2_screen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q2_screen"/>
        <CheckBox android:id="@+id/q2_battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q2_battery"/>
        <CheckBox android:id="@+id/q2_motherboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q2_motherboard"/>
        <CheckBox android:id="@+id/q2_camera" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q2_camera"/>

        <EditText
            android:id="@+id/q2_other_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/survey_q2_other"
            android:inputType="text"
            android:layout_marginBottom="@dimen/margin_medium"/>

        <!-- Q3: Authenticity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/survey_q3"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/margin_small"/>

        <RadioGroup
            android:id="@+id/q3_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium">
            <RadioButton android:id="@+id/q3_original" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q3_original"/>
            <RadioButton android:id="@+id/q3_official_refurb" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q3_official_refurb"/>
            <RadioButton android:id="@+id/q3_unofficial_refurb" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q3_unofficial_refurb"/>
            <RadioButton android:id="@+id/q3_unsure" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q3_unsure"/>
        </RadioGroup>

        <!-- Q4: Usage Intensity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/survey_q4"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/margin_small"/>

        <RadioGroup
            android:id="@+id/q4_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/margin_medium">
            <RadioButton android:id="@+id/q4_light" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/survey_q4_light"/>
            <RadioButton android:id="@+id/q4_moderate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/survey_q4_moderate"/>
            <RadioButton android:id="@+id/q4_heavy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/survey_q4_heavy"/>
        </RadioGroup>

        <!-- Q5: Known Issues -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/survey_q5"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/margin_small"/>

        <CheckBox android:id="@+id/q5_slow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q5_slow"/>
        <CheckBox android:id="@+id/q5_heat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q5_heat"/>
        <CheckBox android:id="@+id/q5_battery_drain" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q5_battery_drain"/>
        <CheckBox android:id="@+id/q5_freezing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q5_freezing"/>
        <CheckBox android:id="@+id/q5_charging" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q5_charging"/>
        <CheckBox android:id="@+id/q5_none" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_q5_none" android:layout_marginBottom="@dimen/margin_medium"/>

        <!-- Q6: Expected Score -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/survey_q6"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/margin_small"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="@dimen/text_size_body"/>

            <SeekBar
                android:id="@+id/q6_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin_small"/>

            <TextView
                android:id="@+id/q6_value"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="50"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Q7: Notes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/survey_q7"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/margin_small"/>

        <EditText
            android:id="@+id/q7_notes"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="@string/survey_q7_hint"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLines="5"
            android:layout_marginBottom="@dimen/margin_large"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_skip"
                android:background="@android:color/transparent"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="@dimen/margin_medium"/>

            <Button
                android:id="@+id/btn_submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_submit"
                android:background="@drawable/button_primary"
                android:textColor="@color/white"
                android:paddingStart="@dimen/padding_large"
                android:paddingEnd="@dimen/padding_large"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
