# Gitignore for Android / Gradle / Kotlin

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
.gradle/

# Gradle files
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# Local configuration file (sdk path, etc)
local.properties

# IntelliJ
*.iml
.idea/
*.ipr
*.iws
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dict

ionaries
.idea/libraries
.idea_modules/
.idea/sqlDataSources.xml
.idea/dynamic.xml
.idea/uiDesigner.xml
.idea/dbnavigator.xml

# Android Studio
*.iml
.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Credentials (IMPORTANT!)
credentials.txt
supabase_config.json

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Log Files
*.log
